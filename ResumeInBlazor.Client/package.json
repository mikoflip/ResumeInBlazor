{
  "imports": {
    "#styles/*": "./Styles/*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.8",
    "glob": "^13.0.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.8"
  },
  "scripts": {
    "format:css": "npx prettier --write \"./Styles/**/*.css\" \"./**/*.razor.pcss\" --plugin=prettier-plugin-tailwindcss",
    "build:css": "node build-scoped-css.js --input Styles/MainStyles.css --output wwwroot/css/styles.css",
    "build": "npm run build:css && dotnet build",
    "dev": "npm run format:css && npm run build:css && dotnet watch run"
  }
}
