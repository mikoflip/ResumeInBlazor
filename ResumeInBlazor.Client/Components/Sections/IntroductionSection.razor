<section class="introduction">
    <h1>
        <span class="name">@Introduction?.Name</span>
    </h1>
    <div class="links">
        <div class="textLinks">
            <a class="email" href="@($"mailto:{Introduction?.Email}")">@Introduction?.Email</a>
            <a class="phone" href="@($"tel:{Introduction?.Phone}")">@Introduction?.Phone</a>
            <a class="location" href="@Introduction?.LocationMap">@Introduction?.Location</a>
            @* <a class="website" href="@Introduction?.Website">@DisplayUrl(Introduction?.Website)</a> *@
        </div>
        <div class="iconLinks">
            <LinkedIn Value="@Introduction?.LinkedIn"/>
            <Github Value="@Introduction?.Github"/>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Introduction? Introduction { get; set; }

    private static string? DisplayUrl(string? url) =>
        url?.Replace("https://", "").Replace("http://", "").TrimEnd('/');
}
